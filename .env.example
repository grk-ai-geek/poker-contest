# Neon Postgres
DATABASE_URL=            # pooled connection string
DIRECT_URL=              # direct connection string (migrations)

# Auth.js
AUTH_SECRET=             # npx auth secret
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=          # optional
AUTH_GOOGLE_SECRET=      # optional

# Email: console | smtp | resend
EMAIL_PROVIDER=console
SMTP_HOST=                # e.g. smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=                # Gmail: an App Password
RESEND_API_KEY=
EMAIL_FROM=              # address only, e.g. no-reply@yourdomain (name comes from the brand)

# Brand (optional overrides of src/config/brand.ts)
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_SHORT=
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_DOMAIN=
NEXT_PUBLIC_SUPPORT_EMAIL=
EMAIL_FROM_NAME=

# Game server
NEXT_PUBLIC_GAME_WS_URL=ws://localhost:4000/ws
GAME_SERVER_URL=http://localhost:4000
GAME_TOKEN_SECRET=
INTERNAL_API_SECRET=
GAME_PORT=4000
ALLOWED_ORIGIN=http://localhost:3000
SPECTATOR_DELAY_MS=30000
ENABLE_DEV_BOTS=1        # ignored in production
